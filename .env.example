# Secret สำหรับลงนาม Flask Session ต้องเปลี่ยนเป็นค่าสุ่มในทุก Environment จริง
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL (จำเป็น) ตัวแปรชุดนี้มีลำดับความสำคัญสูงกว่า DB_* แบบเดิม
SERVER_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB_NAME=enlightenment_compass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password

# OpenAI-compatible Provider (ไม่จำเป็นสำหรับฟีเจอร์ที่ใช้ Graph เท่านั้น)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-2
AI_BASE_URL=https://api.openai.com/v1
AI_IMAGE_TIMEOUT_SECONDS=120

# ชื่อตัวแปร Database แบบเดิม ห้ามกำหนดให้ขัดแย้งกับ SERVER_IP/POSTGRES_* ด้านบน
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=enlightenment_compass
# DB_USER=postgres
# DB_PASSWORD=replace-with-your-database-password
