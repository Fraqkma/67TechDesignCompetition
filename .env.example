# Flask session signing. Generate a long random value for every deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL (required)
SERVER_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB_NAME=enlightenment_compass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password

# OpenAI-compatible provider (required for chat and profile portraits)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-2
AI_BASE_URL=https://api.openai.com/v1
AI_IMAGE_TIMEOUT_SECONDS=120

# Legacy database aliases are also supported:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=enlightenment_compass
# DB_USER=postgres
# DB_PASSWORD=replace-with-your-database-password
